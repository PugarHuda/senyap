pragma language_version >= 0.17;

import CompactStandardLibrary;

// Senyap - sealed-quote RFQ / private OTC on Midnight.
//
// Dual-ledger split:
//   PUBLIC  : quote commitments, nullifiers, authorised makers, fill count,
//             reference price + band, and the winning print.
//   PRIVATE : every quote price and size, the maker's inventory, the taker's
//             order size and limit price. None of it ever reaches the chain.
//
// Flow: a maker posts a sealed commitment on-chain and hands the opening to the
// taker off-chain. The commitment binds the maker, so the quote cannot be faded
// after the taker accepts (no "last look"). The taker then proves, in circuit,
// that the quote it consumed was the best of the ones it received.

// ---------------------------------------------------------------- public state

export ledger makers: Set<Bytes<32>>;   // authorised maker ids

// Quotes live in a Merkle tree, not a Set. With a Set the taker had to name
// every commitment it held in order to prove they were real, which linked the
// losing quotes to the fill: the prices stayed sealed but the participation did
// not. A path proof shows a commitment is in the tree without saying which one.
//
// Historic, because checkRoot has to accept the root as it was when the taker
// built its book. A plain MerkleTree changes root on every insert, so any quote
// posted between building and filling would invalidate the proof.
export ledger quotes: HistoricMerkleTree<10, Bytes<32>>;

export ledger spent: Set<Bytes<32>>;    // nullifiers of consumed quotes
export ledger fills: Counter;           // number of executed fills

export ledger referencePrice: Uint<64>; // public mid, in ticks
export ledger bandBps: Uint<64>;        // max deviation from mid, in bps
export ledger lastFillPrice: Uint<64>;  // the print: only the winner is published
export ledger epoch: Uint<64>;          // expiry clock

// ponytail: `epoch` is advanced by tick(). A production build reads block time
// instead; the clock is not the part of the design under test here.

// ponytail: depth 10 is 1024 quotes. Widening it is a constant, but every extra
// level costs three more hashes in takeQuote, so it is not free.

// ---------------------------------------------------------------------- types

export struct QuoteTerms {
  price: Uint<64>,
  maxSize: Uint<64>,
  expiry: Uint<64>,
  makerId: Bytes<32>,
}

// One slot of the taker's private quote book. `live` marks a real quote; the
// remaining slots are padding and must never be selectable.
export struct QuoteSlot {
  terms: QuoteTerms,
  nonce: Bytes<32>,
  live: Boolean,
}

// ------------------------------------------------------------------ witnesses

witness makerSecret(): Bytes<32>;
witness quoteToPost(): QuoteTerms;
witness quoteNonce(): Bytes<32>;
witness takerOrder(): [Uint<64>, Uint<64>];      // [size, limitPrice]
witness receivedQuotes(): Vector<3, QuoteSlot>;  // the taker's private book
witness chosenIndex(): Uint<8>;

// One membership path per slot, in the same order as receivedQuotes(). Padding
// slots carry a duplicate of a real path: every slot is checked unconditionally,
// so a path that only exists for live slots would leak how many were real.
witness quotePaths(): Vector<3, MerkleTreePath<10, Bytes<32>>>;

// ------------------------------------------------------------------- helpers

export pure circuit makerIdOf(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "senyap:maker:v1"), sk]);
}

export pure circuit commitmentOf(t: QuoteTerms, nonce: Bytes<32>): Bytes<32> {
  return persistentCommit<QuoteTerms>(t, nonce);
}

// Domain-separated so a commitment can never be replayed as some other digest.
export pure circuit nullifierOf(c: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "senyap:nullifier:v1"), c]);
}

// The nonce of what is left of a partially filled quote. Derived rather than
// witnessed so the maker can reconstruct the residual opening from its own
// records: the taker never has to hand anything back for the quote to stay live.
export pure circuit residualNonceOf(nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "senyap:residual:v1"), nonce]);
}

// A padding slot prices at the Uint<64> ceiling so it can never win the min.
export pure circuit effectivePrice(s: QuoteSlot): Uint<64> {
  return s.live ? s.terms.price : 18446744073709551615;
}

export pure circuit min2(a: Uint<64>, b: Uint<64>): Uint<64> {
  return a < b ? a : b;
}

// ------------------------------------------------------------------- circuits

export circuit registerMaker(id: Bytes<32>): [] {
  // ponytail: open registration for the demo. Real deployments gate this behind
  // the governance key; that is orthogonal to the privacy claim being proven.
  makers.insert(disclose(id));
}

export circuit tick(): [] {
  epoch = (epoch + 1) as Uint<64>;
}

export circuit setReference(price: Uint<64>, band: Uint<64>): [] {
  assert(price > 0, "reference price must be positive");
  referencePrice = disclose(price);
  bandBps = disclose(band);
}

// A maker seals a quote. The price never leaves the maker's machine: the band
// check proves the quote is honest relative to the public mid without
// publishing it.
export circuit postQuote(): Bytes<32> {
  const sk = makerSecret();
  const id = makerIdOf(sk);
  assert(makers.member(disclose(id)), "maker is not authorised");

  const t = quoteToPost();
  assert(t.makerId == id, "quote is not bound to this maker");
  assert(t.price > 0, "price must be positive");
  assert(t.maxSize > 0, "size must be positive");
  assert(t.expiry > epoch, "quote is already expired");

  // |price - mid| * 10000 <= mid * bandBps, in multiplication form.
  // No division anywhere in this contract: a division would either need a
  // non-zero proof or silently truncate, and both are soundness bugs.
  const mid = referencePrice;
  const dev = t.price > mid ? t.price - mid : mid - t.price;
  assert(dev * 10000 <= mid * bandBps, "quote is outside the public band");

  // A tree has no membership test, so the duplicate check the Set version did
  // is gone. Posting the same quote twice is harmless: both leaves share one
  // commitment, so they share one nullifier, and only one of them can fill.
  const c = commitmentOf(t, quoteNonce());
  quotes.insert(disclose(c));
  return disclose(c);
}

// The taker consumes one quote and proves it was the best one it held.
export circuit takeQuote(): [] {
  const book = receivedQuotes();
  const paths = quotePaths();
  const [size, limitPrice] = takerOrder();
  const idx = chosenIndex();
  assert(idx < 3, "chosen index out of range");
  assert(size > 0, "fill size must be positive");

  // Every slot must carry a path to a commitment that really is in the tree.
  // Without this the taker could invent worse quotes and manufacture a
  // best-execution proof against fictional competition.
  //
  // All three are checked unconditionally, and only the recomputed root is
  // disclosed - never the path. The path would give away the leaf index, which
  // says when the quote was posted, and that is most of what sealing it was
  // meant to hide.
  assert(quotes.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(paths[0]))),
         "slot 0 is not a live on-chain quote");
  assert(quotes.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(paths[1]))),
         "slot 1 is not a live on-chain quote");
  assert(quotes.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(paths[2]))),
         "slot 2 is not a live on-chain quote");

  // A path proves some leaf is in the tree; this ties each path to the slot it
  // is supposed to belong to. Without it a taker could prove three real quotes
  // exist while its book held something else entirely.
  assert(paths[0].leaf == commitmentOf(book[0].terms, book[0].nonce), "slot 0 path is for another quote");
  assert(paths[1].leaf == commitmentOf(book[1].terms, book[1].nonce), "slot 1 path is for another quote");
  assert(paths[2].leaf == commitmentOf(book[2].terms, book[2].nonce), "slot 2 path is for another quote");

  const best = min2(min2(effectivePrice(book[0]), effectivePrice(book[1])), effectivePrice(book[2]));

  // Private index selection has to be a mux: a ZK circuit cannot index by a
  // secret. With a fixed book of three this is cheaper than a loop anyway.
  const q = idx == 0 ? book[0] : (idx == 1 ? book[1] : book[2]);

  assert(q.live, "chosen slot is empty");
  assert(q.terms.price == best, "not best execution");
  assert(q.terms.price <= limitPrice, "fill is worse than the taker's limit");
  assert(q.terms.maxSize >= size, "quote does not cover the taker's size");
  assert(q.terms.expiry > epoch, "quote has expired");

  const c = commitmentOf(q.terms, q.nonce);
  const nf = nullifierOf(c);
  assert(!spent.member(disclose(nf)), "quote has already been filled");

  // Spending the whole quote and spending part of it look identical on chain:
  // one nullifier, and one new leaf. The residual is inserted unconditionally -
  // a full fill inserts the commitment of a zero-size quote, which no later
  // fill can consume because takeQuote requires a positive size. Making the
  // insert conditional would publish whether the fill was partial.
  const residual = QuoteTerms {
    price: q.terms.price,
    maxSize: (q.terms.maxSize - size) as Uint<64>,
    expiry: q.terms.expiry,
    makerId: q.terms.makerId,
  };
  quotes.insert(disclose(commitmentOf(residual, residualNonceOf(q.nonce))));

  spent.insert(disclose(nf));
  fills.increment(1);

  // The only price that ever becomes public is the one that traded.
  lastFillPrice = disclose(q.terms.price);
}

// A maker withdraws its own quote. Ownership is proved, not asserted.
//
// A Merkle tree cannot delete, so a cancel is a nullifier rather than a
// removal: the leaf stays in the tree and stops being fillable. That is the
// same mechanism a fill uses, which is the point - the chain cannot tell a
// cancelled quote from a filled one.
export circuit cancelQuote(): [] {
  const sk = makerSecret();
  const t = quoteToPost();
  assert(t.makerId == makerIdOf(sk), "not the maker of this quote");

  const c = commitmentOf(t, quoteNonce());
  const nf = nullifierOf(c);
  assert(!spent.member(disclose(nf)), "quote is not live");
  spent.insert(disclose(nf));
}
